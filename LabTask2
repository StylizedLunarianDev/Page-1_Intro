import java.util.Scanner;

public class V3Matrix {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        // [section][students][subjects]
        int V3[][][] = new int[2][3][4];

        // INPUT
        for (int section = 0; section < 2; section++) {
            for (int student = 0; student < 3; student++) {

                System.out.println("\nSection " + (section + 1) +
                                   " Student " + (student + 1));

                System.out.print("Java: ");
                V3[section][student][0] = sc.nextInt();

                System.out.print("Data: ");
                V3[section][student][1] = sc.nextInt();

                System.out.print("Network: ");
                V3[section][student][2] = sc.nextInt();

                // SUM
                V3[section][student][3] =
                    V3[section][student][0] +
                    V3[section][student][1] +
                    V3[section][student][2];
            }
        }

        // OUTPUT
        for (int section = 0; section < 2; section++) {
            System.out.println("\nSECTION " + (section + 1));

            System.out.println("Student\tJava\tData\tNetwork\tSum");

            for (int student = 0; student < 3; student++) {
                System.out.print((student + 1) + "\t");

                for (int sub = 0; sub < 4; sub++) {
                    System.out.print(V3[section][student][sub] + "\t");
                }

                System.out.println();
            }
        }

        sc.close();
    }
}

 
 
